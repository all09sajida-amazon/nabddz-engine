name: Build and Deploy Nabdz Site
on:
  push:
    branches: [ main ]
  schedule:
    # تحديث كل ساعة لسحب المحتوى الجديد
    - cron: '0 * * * *'

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18'

      - name: Install dependencies
        run: npm install

      - name: Build site
        # هذا السكريبت سيقوم بسحب البيانات من بلوجر وبناء الملفات الثابتة
        run: node ./scripts/build.js

      - name: Deploy to GitHub Pages
        uses: peaceiris/actions-gh-pages@v3
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: ./dist
